{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/NEXUS-OS-1.0.1-beta.apk",
      "destination": "https://github.com/sinn1088/nexus-downloads/releases/download/v1.0.1-beta/NEXUS-OS-1.0.1-beta.apk",
      "permanent": false
    },
    {
      "source": "/downloads/NEXUS-OS-1.0.0-beta.apk",
      "destination": "https://github.com/sinn1088/nexus-downloads/releases/download/v1.0.0-beta/NEXUS-OS-1.0.0-beta.apk",
      "permanent": false
    }
  ]
}
